extends layout

block content
  h1 書名: !{book.title}

  p #[strong 著者: ]
    a(href=book.author.url) #{book.author.name}
  p #[strong 概要:] !{book.summary}
  p #[strong ISBN:] #{book.isbn}
  p #[strong ジャンル: ]
    each val, index in book.genre
      a(href=val.url) #{val.name}
      if index < book.genre.length - 1
        |,&nbsp;

  div(style='margin-left:20px;margin-top:20px')
    h2(style='font-size: 1.5rem;') 在庫一覧

    each val in book_instances
      hr
      if val.status=='Available'
        p.text-success 利用可能
      else if val.status=='Maintenance'
        p.text-danger メンテナンス中
      else if val.status=='Loaned'
        p.text-warning 貸出中
      else if val.status=='Reserved'
        p.text-warning 予約済
      else
        // Fallback for any other statuses
        p.text-warning #{val.status}
      p #[strong 奥付情報:] #{val.imprint}
      if val.status!='Available'
        p #[strong 返却期限:] #{val.due_back}
      p #[strong ID: ]
        a(href=val.url) #{val._id}

    else
      p この書籍の在庫はライブラリにありません。

  hr
  p
    a(href=book.url+'/delete') この書籍を削除
  p
    a(href=book.url+'/update') この書籍を更新