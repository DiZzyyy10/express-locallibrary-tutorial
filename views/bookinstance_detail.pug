extends layout

block content

  h1 ID: #{bookinstance._id}

  p #[strong 書名: ]
    a(href=bookinstance.book.url) #{bookinstance.book.title}
  p #[strong 奥付情報:] #{bookinstance.imprint}

  p #[strong ステータス: ]
    if bookinstance.status=='Available'
      span.text-success 利用可能
    else if bookinstance.status=='Maintenance'
      span.text-danger メンテナンス中
    else if bookinstance.status=='Loaned'
      span.text-warning 貸出中
    else if bookinstance.status=='Reserved'
      span.text-warning 予約済
    else
      // Fallback for any other statuses from the enum if not explicitly handled above
      span.text-warning #{bookinstance.status}

  if bookinstance.status!='Available'
    p #[strong 返却期限:] #{bookinstance.due_back_formatted}

  hr
  p
    a(href=bookinstance.url+'/delete') この在庫を削除
  p
    a(href=bookinstance.url+'/update') この在庫を更新