extends layout

block content
  h1= title

  if bookinstance_list.length
    ul
      each val in bookinstance_list
        li
          a(href=val.url) #{val.book.title} : #{val.imprint} -&nbsp;
          if val.status=='Available'
            span.text-success 利用可能
          else if val.status=='Maintenance'
            span.text-danger メンテナンス中
          else if val.status=='Loaned'
            span.text-warning 貸出中
          else if val.status=='Reserved'
            span.text-warning 予約済
          else
            // Fallback for any other statuses, though the enum usually covers these
            span.text-warning #{val.status} 
          
          if val.status!='Available'
            //- Display due date only if not available (i.e., for Loaned, Reserved, Maintenance)
            //- The tutorial's default model for BookInstance only has due_back for 'Loaned' items,
            //- but the condition val.status!='Available' is what the original template uses.
            span  (返却期限: #{val.due_back_formatted})

  else
    p このライブラリには本の在庫がありません。